# === Обязательные секреты (в продакшене обязательно задать случайные значения) ===
# 32+ байта случайной строки для AES-256-GCM шифрования ключей, GitHub PAT и проверки кук
CRM_SECRET=replace-with-32-plus-char-random-secret
# Отдельный ключ шифрования (по умолчанию берётся из CRM_SECRET)
# CRM_ENCRYPTION_KEY=

# === База данных ===
# auto | sqlite | postgres
DB_DIALECT=sqlite
SQLITE_PATH=./data/crm.sqlite
# Для PostgreSQL:
# DATABASE_URL=postgres://crm:password@127.0.0.1:5432/crm

# === Локальное файловое хранилище (вложения чата, скриншоты Оператора) ===
# По умолчанию: <dirname(SQLITE_PATH)>/storage или ./data/storage
CRM_STORAGE_DIR=./data/storage

# === Первичная инициализация главного администратора (без зашитых паролей) ===
CRM_ADMIN_EMAIL=admin@crm.local
CRM_ADMIN_NAME=Главный администратор
# Если задан — при первом входе автоматически создастся super_admin с этим паролем
CRM_ADMIN_PASSWORD=

# === Локальный ИИ-сервер и Python-агент ===
AGENT_URL=http://127.0.0.1:8899
# Адрес прослушивания Python-агента: 127.0.0.1 (только этот ПК) или 0.0.0.0 (доступ из LAN / Docker)
# AGENT_HOST=127.0.0.1
# Разрешить AGENT_URL по локальной сети (LAN) или host.docker.internal (1 = разрешить)
# CRM_ALLOW_REMOTE_AGENT=0
# Через запятую для CORS-белого списка Python-агента (по умолчанию localhost:3000 / 127.0.0.1:3000)
AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AI_BASE_URL=http://127.0.0.1:8888/v1
AI_API_KEY=
AI_MODEL=

# === Субагенты: лимиты выполнения ===
# Автоперенос в новый изолированный чат после N шагов в одном чате
# CRM_SUBAGENT_HANDOFF_STEPS=300
# Максимум автопереносов чата за один запуск
# CRM_SUBAGENT_MAX_ROTATIONS=5
# Общий лимит шагов на ВЕСЬ запуск субагента (включая ротации); 0 = без лимита
# CRM_SUBAGENT_MAX_STEPS=900
# Жёсткий дедлайн сеанса субагента в секундах (наследуется эскалацией/каскадом), минимум 60
# CRM_SUBAGENT_SESSION_SECONDS=1800

# === Сеть, HTTPS и Cookie (для LAN HTTP по умолчанию Secure cookie и HSTS отключены) ===
# Публичный HTTPS-URL при работе за Nginx/reverse-proxy (автоматически включает Secure cookie и HSTS)
# CRM_PUBLIC_URL=https://crm.example.com
# Явно задать Secure-флаг на cookie (1 / 0) или HSTS (1)
# CRM_COOKIE_SECURE=
# CRM_ENABLE_HSTS=0

# === GitHub OAuth (необязательно — можно привязать PAT в настройках Агента) ===
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
